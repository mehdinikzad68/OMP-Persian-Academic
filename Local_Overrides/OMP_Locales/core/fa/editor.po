msgid "editor.monograph.legend.notes"
msgstr "اطلاعات فایل: یادداشت‌ها، گزینه‌های اطلاعیه و تاریخچه (یادداشت‌ها موجود هستند)"

msgid "editor.monograph.legend.notes_new"
msgstr "اطلاعات فایل: یادداشت‌ها، گزینه‌های اطلاعیه و تاریخچه (یادداشت‌های جدیدی از آخرین بازدید افزوده شده است)"

msgid "editor.monograph.legend.edit"
msgstr "ویرایش آیتم"

msgid "editor.monograph.legend.delete"
