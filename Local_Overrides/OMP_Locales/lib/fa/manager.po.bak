msgid "manager.plugins.copyError"
msgstr ""
"افزونه با موفقیت کپی نشد. این ممکن است یک مشکل دسترسی باشد. لطفاً مطمئن "
"شوید که سرور وب قادر به نوشتن در پوشه افزونه‌ها (شامل زیرپوشه‌ها) است، اما "
"فراموش نکنید که پس از اتمام، امنیت آن را دوباره برقرار کنید."

msgid "manager.plugins.deleteError"
msgstr ""
"افزونه \"{$pluginName}\" نتوانست از سیستم فایل حذف شود. این ممکن است یک مشکل "
"دسترسی باشد. لطفاً مطمئن شوید که سرور وب قادر به نوشتن در پوشه افزونه‌ها "
"(شامل زیرپوشه‌ها) است، اما فراموش نکنید که پس از اتهام، امنیت آن را دوباره "
"برقرار کنید."

msgid "manager.plugins.description"
msgstr ""
"این صفحه به مدیر امکان می‌دهد افزونه‌های نصب‌شده فعلی را بررسی و در صورت "
"نیاز پیکربندی کند. افزونه‌ها بر اساس عملکردشان به دسته‌هایی تقسیم شده‌اند. "
"در زیر، دسته‌ها فهرست شده و در هر دسته، مجموعه فعلی افزونه‌های آن نمایش "
"داده می‌شود."

msgid "manager.plugins.uploadDescription"
msgstr ""
"این فرم به شما امکان می‌دهد یک افزونه جدید را بارگذاری و نصب کنید. لطفاً "
"اطمینان حاصل کنید که افزونه به‌صورت فایل فشرده با پسوند tar.gz. فشرده شده "
"باشد."

msgid "manager.plugins.installedVersionNewer"
msgstr ""
"افزونه نصب شده است و از نسخه موجود در کتابخانه جدیدتر می‌باشد."

msgid "manager.plugins.wrongName"
msgstr ""
"فایل version.xml در افزونه بارگذاری‌شده شامل نامی است که با نام افزونه "
"ارتقاء‌یافته مطابقت ندارد."

msgid "manager.plugins.upgradeDescription"
msgstr ""
"این فرم به شما امکان می‌دهد یک افزونه را ارتقاء دهید. لطفاً اطمینان حاصل "
"کنید که افزونه به‌صورت فایل فشرده با پسوند tar.gz. فشرده شده باشد."

msgid "plugins.categories.blocks.description"
msgstr ""
"افزونه‌های بلوک، اجزای پلاگین‌شده رابط کاربری هستند، مانند ابزارهای مختلف "
"نوار کناری."

msgid "plugins.categories.importexport.description"
msgstr ""
"افزونه‌های درون‌ریزی/برون‌بری برای انتقال محتوا به سیستم‌های دیگر و از "
"آن‌ها استفاده می‌شوند."

msgid "plugins.categories.paymethod.description"
msgstr ""
"افزونه‌های روش پرداخت، پشتیبانی از روش‌های مختلف پردازش پرداخت آنلاین را "
"پیاده‌سازی می‌کنند."

msgid "plugins.categories.reports.description"
msgstr ""
"افزونه‌های گزارش برای پیاده‌سازی انواع مختلف گزارش‌ها و استخراج داده‌ها "
"استفاده می‌شوند."

msgid "plugins.importexport.common.error.missingAffiliationName"
msgstr ""
"پدیدآورنده {$authorName} در زبان ارسال اثر ({$localeName}) نام مؤسسه‌ای "
"ندارد. بدون این اطلاعات امکان درون‌ریزی اثر وجود ندارد."

msgid "plugins.importexport.common.error.filesizeMismatch"
msgstr ""
"اندازه فایل ارائه‌شده \"{$expected}\" با اندازه واقعی فایل \"{$actual}\" "
"مطابقت ندارد."

msgid "plugins.importexport.common.error.duplicateRevisionForSubmission"
msgstr ""
"بازنگری \"{$revisionId}\" برای فایل اثر \"{$fileId}\" باعث ایجاد یک رکورد "
"تکراری خواهد شد."
"افزونه \"{$pluginName}\" امکان حذف از روی سرور را ندارد. می‌تواند مشکل از سطح "
"دسترسی باشد. مطمئن شوید که سرور اجازه نوشتن در پوشه افزونه‌ها را دارد."

msgid "manager.plugins.deleteSuccess"
msgstr "افزونه \"{$pluginName}\" با موفقیت حذف شد."

msgid "manager.plugins.description"
msgstr ""
