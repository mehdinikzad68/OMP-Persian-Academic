msgid "sushi.status.description"
msgstr "گزارش‌های کاربرد COUNTER برای {$contextName}."

msgid "sushi.exception.1"
msgstr ""
"تاریخ درخواستی ({$beginDate} یا {$endDate}) در میانهٔ ماه است؛ "
"اما تنها ماه‌های کامل در نظر گرفته می‌شوند."

msgid "sushi.exception.2"
msgstr ""
"شناسهٔ قلم درخواستی ({$itemId}) عددی نیست. این پارامتر شناسهٔ "
"اثر را می‌خواهد."

msgid "sushi.exception.3"
msgstr ""
"پارامتر item_id بیش از یک مقدار دارد، درحالی‌که تنها یک مقدار "
"پذیرفته می‌شود. مقادیر زیر نادیده گرفته می‌شوند: item_id={$itemIdValues}"

msgid "sushi.exception.1030.missing"
msgstr "{$params} موجود نیست."

msgid "sushi.exception.1030.invalid"
msgstr "{$params} نامعتبر است."

msgid "sushi.exception.3020.dateFormat"
msgstr "قالب begin_date یا end_date نامعتبر است."

msgid "sushi.exception.3020.dateRange"
msgstr "بازهٔ تاریخ نامعتبر است."

msgid "sushi.exception.3030"
msgstr ""
"برای تاریخ‌های درخواستی، دادهٔ کاربردی در دسترس نیست. درخواست برای {$beginDate} تا "
"{$endDate} بود."

msgid "sushi.exception.3031"
msgstr ""
"درخواست برای {$beginDate} تا {$endDate} بود؛ اما دادهٔ کاربردی تنها تا "
"{$lastDate} در دسترس است."

msgid "sushi.exception.3032"
msgstr ""
"درخواست برای {$beginDate} تا {$endDate} بود؛ اما دادهٔ کاربردی تنها از "
"{$earliestDate} در دسترس است."

msgid "sushi.exception.3050"
msgstr ""
"درخواست شامل پارامترهایی است ({$params}) که در بستر گزارش ارائه‌شده شناخته نمی‌شوند."

msgid "sushi.exception.3060"
msgstr "مقادیر پالایهٔ زیر پشتیبانی نمی‌شوند: {$filterValues}"

msgid "sushi.exception.3062"
msgstr "مقادیر ویژگی زیر پشتیبانی نمی‌شوند: {$attributeValues}"
