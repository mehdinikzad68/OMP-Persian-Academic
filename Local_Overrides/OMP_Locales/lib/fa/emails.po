msgid "mailable.userRoleAssignmentInvitationNotify.name"
msgstr "اطلاع دعوت کاربر به نقش"

msgid "mailable.userRoleAssignmentInvitationNotify.description"
msgstr "این رایانامه به کاربرانی فرستاده می‌شود که برای کسب برخی نقش‌ها دعوت شده‌اند."

msgid "emails.userRoleAssignmentInvitationNotify.subject"
msgstr "شما به نقش‌های تازه دعوت شده‌اید"

msgid "emails.userRoleAssignmentInvitationNotify.body"
msgstr ""
"<div class='email-container'>"
"    <div class='email-header'>"
"        <h2>دعوت به نقش تازه</h2>"
"    </div>"
"    <div class='email-content'>"
"        <p>{$recipientName} گرامی،</p>"
"        <p>با توجه به توانایی‌های شما، {$inviterName} شما را به نقش‌های تازه در {$contextName} دعوت کرده است.</p>"
"        <p>در {$contextName} به حریم خصوصی شما اهمیت می‌دهیم؛ از این رو گام‌هایی برداشته‌ایم تا با مقررات GDPR هم‌راستا باشیم، از جمله اینکه خود شما داده‌هایتان را وارد کنید و انتخاب کنید چه کسی چه اطلاعاتی را ببیند. برای اطلاع بیشتر دربارهٔ نحوهٔ پردازش داده‌هایتان، سیاست حفظ حریم خصوصی ما را ببینید.</p>"
"        <div>{$existingRoles}</div>"
"        <div>{$rolesAdded}</div>"
"        <p>پس از پذیرش دعوت، به {$contextName} هدایت خواهید شد.</p>"
"        <p>در صورت هر پرسشی دربارهٔ فرایند، با من تماس بگیرید.</p>"
"        <p><a href='{$acceptUrl}' class='btn btn-accept'>پذیرش دعوت</a></p>"
"        <p><a href='{$declineUrl}' class='btn btn-decline'>رد دعوت</a></p>"
"        <p>با احترام،</p>"
"        <p>{$contextName}</p>"
"    </div>"
"</div>"

