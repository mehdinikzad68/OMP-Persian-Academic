msgstr ""
"این رایانامه به کاربرانی فرستاده می‌شود که تغییر نشانی رایانامهٔ خود را درخواست کرده‌اند."

msgid "emails.changeProfileEmailInvitationNotify.body"
msgstr ""
"<p>{$recipientName} گرامی،</p>"
"<p>این رایانامه را دریافت می‌کنید زیرا برایتان درخواست تغییر نشانی رایانامه به {$newEmail} ثبت شده است.</p>"
"<p>اگر این درخواست از سوی شما بوده، لطفاً برای <a href=\"{$acceptInvitationUrl}\">تأیید</a> تغییر نشانی رایانامه اقدام کنید.</p>"
"<p>همواره می‌توانید این تغییر نشانی را <a href=\"{$declineInvitationUrl}\">رد</a> کنید.</p>"
"<p>در صورت هر پرسشی دربارهٔ اثر یا فرایند داوری، با من تماس بگیرید.</p>"
"<p>با احترام،</p>"
"{$siteContactName}"

msgid "emails.orcidCollectAuthorId.subject"
msgstr "شناسهٔ ORCID دست‌نوشته"

