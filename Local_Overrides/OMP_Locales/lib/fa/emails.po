msgstr ""
"<div class='section'>"
"    <div class='section-number'>{$sectionNumber}.</div>"
"    <div class='section-content'>"
"        <h2>{$sectionName}</h2>"
"        <p>از تاریخ {$dateStart}</p>"
"        <p>{$sectionEndingDate}</p>"
"        <p>{$sectionMastheadAppear}</p>"
"    </div>"
"</div>"

