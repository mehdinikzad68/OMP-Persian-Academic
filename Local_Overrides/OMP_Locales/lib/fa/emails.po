msgid "emails.submissionAck.subject"
msgstr "قدردانی برای ارسال اثر"

msgid "emails.submissionAck.body"
msgstr "پدیدآورنده گرامی، {$recipientName}<br /><br />از ارسال اثر خود با عنوان «{$submissionTitle}» به انتشارات {$contextName} سپاسگزاریم. وضعیت بررسی اثر از طریق سامانه قابل پیگیری خواهد بود.<br /><br />با احترام،<br />{$contextSignature}"

msgid "emails.submissionAck.description"
msgstr "این ایمیل به صورت خودکار برای پدیدآورنده مسئول، جهت تأیید دریافت اثر ارسالی، صادر می‌گردد."

msgid "emails.reviewAck.subject"
msgstr "قدردانی از انجام داوری اثر"

msgid "emails.reviewAck.body"
msgstr "داور گرامی، {$recipientName}<br /><br />بدین‌وسیله از تلاش‌های ارزشمند و نظرات تخصصی شما در داوری اثر «{$submissionTitle}» برای انتشارات {$contextName} صمیمانه سپاسگزاری می‌گردد.<br /><br />با احترام،<br />{$contextSignature}"

msgid "emails.decision.notifyReviewers.subject"
msgstr "اطلاع‌رسانی تصمیم سردبیری در خصوص اثر داوری شده"

msgid "emails.decision.notifyReviewers.body"
msgstr "داور گرامی، {$recipientName}<br /><br />از تلاش‌های ارزشمند شما در داوری اثر «{$submissionTitle}» سپاسگزاریم. بدین‌وسیله به اطلاع می‌رساند که تصمیم نهایی سردبیری در خصوص این اثر اتخاذ گردیده است. شما می‌توانید با مراجعه به پنل کاربری خود، جزئیات تصمیم و نظرات سایر داوران را مشاهده نمایید.<br /><br />با احترام،<br />{$contextSignature}"

msgid "emails.decision.notifyOtherAuthors.subject"
msgstr "اطلاع‌رسانی تصمیم نهایی در خصوص اثر مشترک"

msgid "emails.decision.notifyOtherAuthors.body"
msgstr "پدیدآورنده گرامی، {$recipientName}<br /><br />بدین‌وسیله به اطلاع می‌رساند که تصمیم نهایی سردبیری در خصوص اثر مشترک شما با عنوان «{$submissionTitle}» اتخاذ گردیده است. پدیدآورنده مسئول نیز همزمان در جریان جزئیات این تصمیم قرار گرفته است. برای مشاهده آخرین وضعیت اثر می‌توانید به وب‌سایت انتشارات مراجعه نمایید.<br /><br />با احترام،<br />{$contextSignature}"

msgid "emails.editorDecisionSendToExternal.subject"
msgstr "تصمیم سردبیری: ارسال اثر به داوری خارجی"

msgid "emails.editorDecisionSendToExternal.body"
msgstr "پدیدآورنده گرامی، {$recipientName}<br /><br />بدین‌وسیله به اطلاع می‌رساند که اثر شما با عنوان «{$submissionTitle}» جهت ارزیابی تخصصی به مرحله داوری خارجی ارسال گردیده است.<br /><br />با احترام،<br />{$contextSignature}"

msgid "emails.editorDecisionSendToProduction.subject"
msgstr "تصمیم سردبیری: پذیرش و ارسال اثر به مرحله آماده‌سازی"

msgid "emails.editorDecisionSendToProduction.body"
msgstr "پدیدآورنده گرامی، {$authors}<br /><br />بدین‌وسیله به اطلاع می‌رساند که فرآیند داوری اثر شما با عنوان «{$submissionTitle}» به پایان رسیده و جهت طی مراحل نهایی نشر به واحد آماده‌سازی ارسال گردیده است.<br /><br />مشاهده وضعیت اثر: {$submissionUrl}<br /><br />با احترام،<br />{$contextSignature}"

msgid "emails.editorDecisionRevisions.subject"
msgstr "تصمیم سردبیری: نیاز به انجام اصلاحات در اثر"

msgid "emails.editorDecisionRevisions.body"
msgstr "پدیدآورنده گرامی، {$authors}<br /><br />بدین‌وسیله به اطلاع می‌رساند که تصمیم سردبیری در خصوص اثر ارسالی شما با عنوان «{$submissionTitle}» اتخاذ گردیده است. بر این اساس، اثر مذکور جهت ادامه فرآیند ارزیابی نیاز به انجام اصلاحات دارد.<br /><br />لطفاً نظرات داوران را در پنل کاربری خود مشاهده و نسبت به اعمال اصلاحات اقدام نمایید.<br /><br />لینک دسترسی: {$submissionUrl}<br /><br />با احترام،<br />{$contextSignature}"

msgid "emails.editorDecisionResubmit.subject"
msgstr "تصمیم سردبیری: ارسال دوباره اثر جهت داوری مجدد"

msgid "emails.editorDecisionResubmit.body"
msgstr "پدیدآورنده گرامی، {$authors}<br /><br />بدین‌وسیله به اطلاع می‌رساند که تصمیم سردبیری در خصوص اثر ارسالی شما با عنوان «{$submissionTitle}» اتخاذ گردیده است. مقرر شد پس از اعمال اصلاحات اساسی، اثر جهت داوری مجدد به سامانه ارسال گردد.<br /><br />با احترام،<br />{$contextSignature}"

msgid "emails.editorDecisionDecline.subject"
msgstr "تصمیم سردبیری: عدم پذیرش اثر"

msgid "emails.editorDecisionDecline.body"
msgstr "پدیدآورنده گرامی، {$authors}<br /><br />بدین‌وسیله به اطلاع می‌رساند که پس از بررسی‌های تخصصی، تصمیم نهایی سردبیری مبنی بر عدم پذیرش اثر شما با عنوان «{$submissionTitle}» جهت انتشار در {$contextName} اتخاذ گردیده است.<br /><br />با احترام،<br />{$contextSignature}"

msgid "emails.editorRecommendation.subject"
msgstr "توصیه دبیر در خصوص اثر ارسالی"

msgid "emails.editorRecommendation.body"
msgstr "سردبیر گرامی، {$editors}<br /><br />توصیه نهایی اینجانب در خصوص اثر ارسالی با عنوان «{$submissionTitle}» به شرح ذیل می‌باشد:<br />{$recommendation}<br /><br />با احترام،<br />{$contextSignature}"

msgid "emails.copyeditRequest.subject"
msgstr "درخواست انجام ویراستاری اثر"

msgid "emails.copyeditRequest.body"
msgstr "ویراستار گرامی، {$recipientName}<br /><br />از شما درخواست می‌شود فرآیند ویراستاری اثر «{$submissionTitle}» را در انتشارات {$contextName} بر عهده بگیرید.<br /><br />لینک دسترسی: {$submissionUrl}<br /><br />با احترام،<br />{$contextSignature}"

msgid "emails.editorDecisionNewReviewRound.subject"
msgstr "تصمیم سردبیری: آغاز دور جدید داوری"

msgid "emails.editorDecisionNewReviewRound.body"
msgstr "{$authors}:<br /><br />در مورد اثر ارسالی شما (&quot;{$submissionTitle}&quot;) در {$contextName} تصمیم سردبیری اتخاذ شده است. مقرر گردید اثر جهت ارزیابی دقیق‌تر به دور جدید داوری ارسال گردد.<br /><br />مشاهده وضعیت اثر ارسالی: {$submissionUrl}"

msgid "emails.editorDecisionRevertDecline.subject"
msgstr "بازگردانی تصمیم سردبیری مبنی بر عدم پذیرش اثر"

msgid "emails.editorDecisionRevertDecline.body"
msgstr "پدیدآورنده گرامی، {$recipientName}<br /><br />بدین‌وسیله به اطلاع می‌رساند که تصمیم قبلی مبنی بر عدم پذیرش اثر شما با عنوان «{$submissionTitle}» لغو گردیده و اثر جهت بررسی مجدد به جریان افتاده است.<br /><br />با احترام،<br />{$contextSignature}"

msgid "emails.editorDecisionRevertInitialDecline.subject"
msgstr "بازگردانی تصمیم سردبیری مبنی بر عدم پذیرش اولیه اثر"

msgid "emails.editorDecisionRevertInitialDecline.body"
msgstr "پدیدآورنده گرامی، {$recipientName}<br /><br />بدین‌وسیله به اطلاع می‌رساند که تصمیم قبلی مبنی بر عدم پذیرش اولیه اثر شما با عنوان «{$submissionTitle}» لغو گردیده و فرآیند بررسی اثر مجدداً آغاز شده است.<br /><br />با احترام،<br />{$contextSignature}"

msgid "emails.editorDecisionInitialDecline.subject"
msgstr "تصمیم سردبیری: عدم پذیرش اولیه اثر"

msgid "emails.editorDecisionInitialDecline.body"
msgstr "پدیدآورنده گرامی، {$recipientName}<br /><br />بدین‌وسیله به اطلاع می‌رساند که پس از بررسی اولیه، اثر شما با عنوان «{$submissionTitle}» جهت ارسال به مرحله داوری در انتشارات {$contextName} پذیرفته نشده است.<br /><br />با احترام،<br />{$contextSignature}"

msgid "emails.editorialReminder.subject"
msgstr "یادآوری: کارهای در انتظار اقدام در بخش سردبیری"

msgid "emails.editorialReminder.body"
msgstr "دبیر گرامی، {$recipientName}<br /><br />این یک پیام یادآوری در خصوص اثر «{$submissionTitle}» می‌باشد که در انتظار اقدام جنابعالی در مرحله سردبیری است.<br /><br />لینک دسترسی: {$submissionUrl}<br /><br />با احترام،<br />{$contextSignature}"

msgid "discussion.notification.description"
msgstr "این اطلاعیه زمانی ارسال می‌شود که پیام جدیدی در گفتگوهای مربوط به اثر ثبت گردد."

msgid "emails.editorDecisionBackFromProduction.subject"
msgstr "بازگشت اثر از مرحله آماده‌سازی به مرحله سردبیری"

msgid "emails.editorDecisionBackFromProduction.body"
msgstr "پدیدآورنده گرامی، {$recipientName}<br /><br />بدین‌وسیله به اطلاع می‌رساند که اثر شما با عنوان «{$submissionTitle}» جهت بررسی‌های تکمیلی از مرحله آماده‌سازی به مرحله سردبیری بازگردانده شده است.<br /><br />با احترام،<br />{$contextSignature}"

msgid "emails.editorDecisionBackFromCopyediting.subject"
msgstr "بازگشت اثر از مرحله ویراستاری به مرحله سردبیری"

msgid "emails.editorDecisionBackFromCopyediting.body"
msgstr "پدیدآورنده گرامی، {$recipientName}<br /><br />بدین‌وسیله به اطلاع می‌رساند که اثر شما با عنوان «{$submissionTitle}» جهت بررسی‌های تکمیلی از مرحله ویراستاری به مرحله سردبیری بازگردانده شده است.<br /><br />با احترام،<br />{$contextSignature}"

msgid "emails.editorDecisionCancelReviewRound.subject"
msgstr "لغو دور داوری توسط سردبیر"

msgid "emails.editorDecisionCancelReviewRound.body"
msgstr "پدیدآورنده گرامی، {$recipientName}<br /><br />بدین‌وسیله به اطلاع می‌رساند که دور داوری جاری برای اثر شما با عنوان «{$submissionTitle}» لغو گردیده است. جزئیات بیشتر و مراحل بعدی از طریق پنل کاربری قابل مشاهده خواهد بود.<br /><br />با احترام،<br />{$contextSignature}"

msgid "emails.reviewResendRequest.subject"
msgstr "درخواست ارسال مجدد نظرات داوری"

msgid "emails.reviewResendRequest.body"
msgstr "داور گرامی، {$recipientName}<br /><br />با توجه به نیاز به بررسی‌های بیشتر، از شما درخواست می‌شود نظرات داوری خود در خصوص اثر «{$submissionTitle}» را مجدداً ارسال نمایید.<br /><br />با احترام،<br />{$contextSignature}"

msgid "emails.footer.unsubscribe"
msgstr "برای لغو اشتراک از این اطلاعیه‌ها، به آدرس {$unsubscribeUrl} مراجعه نمایید."

msgid "emails.footer.unsubscribe.discussion"
msgstr "برای لغو اشتراک از این گفتگو، به آدرس {$unsubscribeUrl} مراجعه نمایید."

msgid "emails.footer.unsubscribe.automated"
msgstr "این یک پیام خودکار است؛ برای لغو اشتراک به آدرس {$unsubscribeUrl} مراجعه نمایید."

msgid "emailTemplate.variable.unsubscribe"
msgstr "پیوند لغو اشتراک از دریافت اطلاعیه‌ها"

msgid "emails.discussion.subject"
msgstr "[{$contextAbbrev}] پیام جدید در گفتگو: {$discussionTitle}"

msgid "emails.discussion.body"
msgstr "لطفاً پیام خود را وارد کنید"

msgid "emails.versionCreated.subject"
msgstr "اطلاع‌رسانی: ایجاد نسخه جدید از اثر"

msgid "emails.versionCreated.body"
msgstr "پدیدآورنده گرامی، {$recipientName}<br /><br />بدین‌وسیله به اطلاع می‌رساند که نسخه جدیدی از اثر شما با عنوان «{$submissionTitle}» در سامانه انتشارات {$contextName} ایجاد گردیده است.<br /><br />مشاهده جزئیات: {$submissionUrl}<br /><br />با احترام،<br />{$contextSignature}"

msgid "emails.reviewComplete.subject"
msgstr "اتمام فرآیند داوری اثر"

msgid "emails.reviewComplete.body"
msgstr "دبیر گرامی، {$recipientName}<br /><br />فرآیند داوری اثر «{$submissionTitle}» توسط داور مربوطه به پایان رسیده و نظرات نهایی در سامانه ثبت گردیده است.<br /><br />مشاهده نظرات داوری: {$submissionUrl}<br /><br />با احترام،<br />{$contextSignature}"

msgid "emails.reviewEdit.subject"
msgstr "اطلاع‌رسانی: ویرایش نظرات داوری"

msgid "emails.reviewEdit.body"
msgstr "دبیر گرامی، {$recipientName}<br /><br />نظرات داوری مربوط به اثر «{$submissionTitle}» توسط داور ویرایش گردیده است.<br /><br />مشاهده تغییرات: {$submissionUrl}<br /><br />با احترام،<br />{$contextSignature}"

msgid "emails.reviewConfirm.subject"
msgstr "تأیید پذیرش داوری اثر"

msgid "emails.reviewConfirm.body"
msgstr "دبیر گرامی، {$recipientName}<br /><br />بدین‌وسیله به اطلاع می‌رساند که داور مربوطه، درخواست داوری اثر «{$submissionTitle}» را پذیرفته است.<br /><br />با احترام،<br />{$contextSignature}"

msgid "emails.submissionSavedForLater.subject"
msgstr "اثر شما با موفقیت جهت تکمیل در آینده ذخیره شد"

msgid "emails.submissionSavedForLater.body"
msgstr "پدیدآورنده گرامی، {$recipientName}<br /><br />فرآیند ارسال اثر شما با عنوان «{$submissionTitle}» به صورت موقت ذخیره گردیده است. شما می‌توانید در هر زمان با ورود به پنل کاربری خود، مراحل ارسال را تکمیل نمایید.<br /><br />لینک دسترسی: {$submissionUrl}<br /><br />با احترام،<br />{$contextSignature}"

msgid "emails.submissionNeedsEditor.subject"
msgstr "اثر جدید در انتظار انتساب دبیر"

msgid "emails.submissionNeedsEditor.body"
msgstr "مدیر گرامی، {$recipientName}<br /><br />اثر جدیدی با عنوان «{$submissionTitle}» به سامانه ارسال گردیده و در انتظار انتساب دبیر مسئول جهت آغاز فرآیند بررسی می‌باشد.<br /><br />مشاهده اثر: {$submissionUrl}<br /><br />با احترام،<br />{$contextSignature}"

msgid "emails.submissionAckNotUser.description"
msgstr "این ایمیل زمانی ارسال می‌شود که پدیدآورنده، اثر را به نمایندگی از شخص دیگری (مانند همکار) ارسال کرده باشد."

msgid "emails.submissionAckNotAuthor.subject"
msgstr "قدردانی برای ارسال اثر"

msgid "emails.submissionAckNotAuthor.body"
msgstr ""
"با سلام،<br />\n"
"<br />\n"
"{$submitterName} اثر &quot;{$submissionTitle}&quot; را به انتشارات "
"{$contextName} ارسال نمودند.<br />\n"
"<br />\n"
"در صورت داشتن هرگونه سؤالی با من تماس حاصل فرمایید. از اینکه نتیجهٔ پژوهش "
"خود را برای این انتشارات ارسال نمودید، سپاس‌گزاریم.<br />\n"
"<br />\n"
"{$contextSignature}"

