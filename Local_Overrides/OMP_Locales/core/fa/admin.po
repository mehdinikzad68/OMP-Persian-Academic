msgid "admin.overwriteConfigFileInstructions"
msgstr ""
"<h4>توجه!</h4>\n"
"<p>سیستم نتوانست به‌طور خودکار فایل پیکربندی را بازنویسی کند. برای اعمال "
"تغییرات پیکربندی، باید فایل <tt>config.inc.php</tt> را در یک ویرایشگر متن "
"مناسب باز کرده و محتویات آن را با محتویات فیلد متنی زیر جایگزین کنید.</p>"

msgid "admin.settings.enableBulkEmails.description"
msgstr ""
"انتشارات میزبانی‌شده‌ای که مجاز به ارسال ایمیل‌های انبوه هستند را انتخاب کنید. "
"هنگامی که این ویژگی فعال باشد، مدیر انتشارات می‌تواند برای همه کاربران ثبت‌نام‌"
"کرده در انتشارات خود ایمیل ارسال کند.<br><br>سوءاستفاده از این ویژگی برای "
"ارسال ایمیل‌های ناخواسته ممکن است قوانین ضد هرزنامه در برخی حوزه‌های قضایی را "
"نقض کرده و باعث مسدود شدن ایمیل‌های سرور شما به عنوان هرزنامه شود.<br><br>"
"محدودیت‌های بیشتر برای این ویژگی را می‌توان برای هر انتشارات از طریق جادوگر "
"تنظیمات در فهرست <a href=\"{$hostedContextsUrl}\">بسترهای میزبانی‌شده</a> "
"فعال کرد."

msgid "admin.settings.disableBulkEmailRoles.description"
msgstr ""
"مدیر انتشارات نمی‌تواند برای هیچ‌یک از نقش‌های انتخاب‌شده در زیر ایمیل انبوه "
"ارسال کند. از این تنظیم برای محدود کردن سوءاستفاده از ویژگی اطلاع‌رسانی ایمیلی "
"استفاده کنید.<br><br>ویژگی ایمیل انبوه را می‌توان به‌طور کامل برای این انتشارات "
"در <a href=\"{$siteSettingsUrl}\">مدیریت > تنظیمات سایت</a> غیرفعال کرد."

msgid "admin.settings.disableBulkEmailRoles.contextDisabled"
msgstr ""
"ویژگی ایمیل انبوه برای این انتشارات غیرفعال شده است. این ویژگی را در "
"<a href=\"{$siteSettingsUrl}\">مدیریت > تنظیمات سایت</a> فعال کنید."

msgid "admin.siteManagement.description"
msgstr ""
"انتشارات را به این سایت اضافه، ویرایش یا حذف کنید و تنظیمات سراسری سایت را "
"مدیریت نمایید."

msgid "admin.job.processLogFile.invalidLogEntry.chapterId"
msgstr "شناسه فصل یک مقدار صحیح نیست"

msgid "admin.job.processLogFile.invalidLogEntry.seriesId"
msgstr "شناسه مجموعه یک مقدار صحیح نیست"

msgid "admin.settings.statistics.geo.description"
msgstr ""
"نوع آمار جغرافیایی مصرف را که می‌تواند توسط انتشارات این سایت جمع‌آوری شود "
"انتخاب کنید. آمار جغرافیایی دقیق‌تر ممکن است اندازه پایگاه داده شما را به‌طور "
"قابل توجهی افزایش دهد."

msgid "admin.settings.statistics.institutions.description"
msgstr ""
"آمار مؤسساتی را فعال کنید اگر می‌خواهید انتشارات این سایت بتوانند آمار مصرف را "
"بر اساس مؤسسه جمع‌آوری کنند. انتشارات باید مؤسسه و محدوده IP آن را اضافه کنند."

msgid "admin.settings.statistics.sushi.public.description"
msgstr ""
"تعیین می‌کند که آیا نقاط پایانی API SUSHI برای همه انتشارات این سایت به‌صورت "
"عمومی در دسترس باشد یا خیر."

msgid "admin.settings.statistics.sushiPlatform.isSiteSushiPlatform"
msgstr "استفاده از سایت به عنوان بستر برای همه انتشارات"
