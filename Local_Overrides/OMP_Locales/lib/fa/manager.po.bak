msgstr "لغو رد اولیه اثر - اطلاع‌رسانی به پدیدآورنده"

msgid "mailable.decision.revertInitialDecline.notifyAuthor.description"
msgstr "ایمیلی که پس از لغو تصمیم رد اولیه اثر، به پدیدآورنده ارسال می‌شود."

msgid "mailable.decision.sendExternalReview.notifyAuthor.name"
msgstr "ارسال به داوری خارجی - اطلاع‌رسانی به پدیدآورنده"

msgid "mailable.decision.sendExternalReview.notifyAuthor.description"
msgstr "ایمیلی که پس از ارسال اثر به مرحله داوری خارجی، به پدیدآورنده ارسال می‌شود."

msgid "mailable.decision.sendToProduction.notifyAuthor.name"
msgstr "ارسال به تولید - اطلاع‌رسانی به پدیدآورنده"

msgid "mailable.decision.sendToProduction.notifyAuthor.description"
msgstr "ایمیلی که پس از ارسال اثر به مرحله تولید، به پدیدآورنده ارسال می‌شود."

msgid "mailable.decision.skipReview.notifyAuthor.name"
msgstr "عبور از مرحله داوری - اطلاع‌رسانی به پدیدآورنده"

msgid "mailable.decision.skipReview.notifyAuthor.description"
msgstr "ایمیلی که پس از تصمیم سردبیری مبنی بر عبور اثر از مرحله داوری، به پدیدآورنده ارسال می‌شود."

msgid "mailable.decision.recommendation.notifyEditors.name"
msgstr "توصیه داور - اطلاع‌رسانی به دبیران"

msgid "mailable.decision.recommendation.notifyEditors.description"
msgstr "ایمیلی که پس از ثبت توصیه نهایی داور، به دبیران مسئول ارسال می‌شود."

msgid "mailable.reviewConfirm.name"
msgstr "تأیید داوری"

msgid "mailable.reviewConfirm.description"
msgstr ""
"ایمیلی از طرف داور به سردبیر یا دبیر بخشبرای اطلاع از پذیرش انجام داوری"

msgid "mailable.reviewDecline.name"
msgstr "رد درخواست داوری"

msgid "mailable.reviewDecline.description"
msgstr ""
"ایمیلی از طرف داور به سردبیر یا دبیر بخش برای اطلاع از عدم پذیرش انجام داوری"

msgid "mailable.reviewRemind.name"
msgstr "یادآوری داوری"

msgid "mailable.reviewRemind.description"
msgstr "ایمیلی که دبیر یا دبیر بخش به داور برای یادآوری مهلت انجام داوری ارسال می‌کند."

msgid "mailable.reviewRemindAuto.name"
msgstr "یادآوری خودکار داوری"

msgid "mailable.reviewRemindAuto.description"
msgstr "این ایمیل به صورت خودکار در صورتی که مهلت داوری به پایان رسیده باشد، برای داور ارسال می‌گردد."

msgid "mailable.reviewAcknowledgement.name"
msgstr "دریافت داوری"

msgid "mailable.reviewAcknowledgement.description"
msgstr "ایمیلی که پس از تکمیل داوری توسط داور، برای وی ارسال می‌شود."

msgid "mailable.reviewResponseOverdueAuto.name"
msgstr "اتمام مهلت پاسخ داوری (خودکار)"

msgid "mailable.reviewResponseOverdueAuto.description"
msgstr "این ایمیل به صورت خودکار زمانی که مهلت داور برای پذیرش یا رد درخواست داوری به پایان رسیده باشد، برای وی ارسال می‌گردد."

msgid "mailable.reviewRequest.name"
msgstr "درخواست داوری"

msgid "mailable.reviewRequest.description"
msgstr "این ایمیل از طرف دبیر به داور، جهت درخواست ارزیابی یک اثر جدید ارسال می‌گردد."

msgid "mailable.reviewRequestSubsequent.name"
msgstr "درخواست داوری (دور بعدی)"

msgid "mailable.reviewRequestSubsequent.description"
msgstr "این ایمیل از طرف دبیر به داور، جهت درخواست ارزیابی اثر در دورهای بعدی داوری ارسال می‌گردد."

msgid "plugins.importexport.common.error.currentPublicationNullOrMissing"
msgstr "نسخه انتشاری فعلی خالی یا گم‌شده است."

msgid "plugins.importexport.common.error.submissionChildFailed"
msgstr "پردازش اطلاعات وابسته به اثر ناموفق بود."

msgid "mailable.editorialReminder.name"
msgstr "یادآوری سردبیری"

msgid "mailable.editorialReminder.description"
msgstr "ایمیل خودکار هفتگی به دبیران جهت یادآوری وظایف معوقه."

msgid "mailable.passwordResetRequested.name"
msgstr "درخواست بازنشانی رمز عبور"

msgid "mailable.passwordResetRequested.description"
msgstr ""
"این ایمیل به کاربر ثبت‌نام‌شده ارسال می‌شود هنگامی که اعلام کند رمز عبور "
"خود را فراموش کرده یا قادر به ورود به سامانه نیست. این ایمیل شامل پیوندی "
"است که کاربر می‌تواند برای بازنشانی رمز عبور خود از آن استفاده کند."

msgid "mailable.userRegister.name"
msgstr "ثبت‌نام کاربر"

msgid "mailable.userRegister.description"
msgstr "این ایمیل برای خوش‌آمدگویی به کاربر جدید پس از ثبت‌نام در سامانه ارسال می‌گردد."

msgid "mailable.reviewerRegister.name"
msgstr "ثبت‌نام داور"

msgid "mailable.reviewerRegister.description"
msgstr ""
"این ایمیل به داور تازه ثبت‌نام‌شده جهت خوش‌آمدگویی به سامانه و ارائه "
"اطلاعات نام کاربری و رمز عبور وی ارسال می‌شود."

